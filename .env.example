# Colour-model backend. 'llamacpp' (default) or 'ollama'.
COLOUR_BACKEND=llamacpp

# llama.cpp server (OpenAI-compatible endpoint)
LLAMA_HOST=http://127.0.0.1:8080
LLAMA_BIN=/home/pengen/llama.cpp/build/bin/llama-server
LLAMA_MODEL_PATH=/home/pengen/models/gemma-4-E4B_q4_0-it.gguf
# Reported verbatim in the cache header + manifest; the colour table is only
# reproducible if the model is identified exactly.
COLOUR_MODEL_TAG=gemma-4-E4B-it-qat-q4_0

# Ollama alternative (spec section 6.2)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Colour pass budget: colour tracks covering this share of events, capped at MAX_TRACKS.
COLOUR_EVENT_COVERAGE=0.95
COLOUR_MAX_TRACKS=2000
COLOUR_CONCURRENCY=6
